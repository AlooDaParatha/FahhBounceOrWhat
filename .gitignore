# ---------------------------------------------------------------------------
# Unreal Engine — generated files
# ---------------------------------------------------------------------------
# Everything below is regenerated by the editor/compiler and must never be
# committed. Committing these is the #1 cause of multi-GB Unreal repos.

# Compiled binaries, modules, and build artifacts
[Bb]inaries/
*.pdb
*.dll
*.exe
*.lib
*.exp
*.target
*.modules
*.version

# Intermediate build files (headers, generated source, makefiles)
[Ii]ntermediate/
*.obj
*.o
*.generated.*
*.gen.cpp
*.gen.h

# Editor-saved state, logs, autosaves, crash reports
[Ss]aved/
*.log
*.tmp
*.autosave
*.uasset.tmp
CrashReportClient*
CrashContext.runtime-xml
AutodeskCert/
D3DSCache/

# Derived data cache (shader compilation, asset registry caches)
[Dd]erivedDataCache/

# Build scripts output (keeps the committed .bat/.xml files under Build/)
Build/Windows/FileOpenOrder/
Build/**/FileOpenOrder/

# ---------------------------------------------------------------------------
# Unreal Engine — local-only files that live alongside tracked assets
# ---------------------------------------------------------------------------
# Per-user scratch folders (developer-local test content, never shipped)
Content/Developers/
Collections/Developers/

# ---------------------------------------------------------------------------
# UE source control / perforce integration
# ---------------------------------------------------------------------------
# Unreal Revision Control / Perforce metadata
*.p4config
*.p4ignore
.gitattributes.orig

# ---------------------------------------------------------------------------
# IDE / editor cruft
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.sln.docstates
*.DotSettings.user
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Build output & packages
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ipa
*.app
*.xcarchive
*.xcodeproj
*.xcworkspace
*.dSYM/
*.dSYM.zip
*.ipa
Crashes/

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
node_modules/
*.log.lock
